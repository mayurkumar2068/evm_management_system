<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production APIs are HTTPS. Do not persist cleartext or user CAs. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
