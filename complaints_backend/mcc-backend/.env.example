ENV=dev
DATABASE_URL=mysql+pymysql://root:Mayur%408665@127.0.0.1:3306/ems?charset=utf8mb4
JWT_SECRET=replace-with-64-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Returns the OTP in /auth/otp/send and /auth/login responses. Must be false in prod.
OTP_DEBUG_RETURN=true
STORAGE_DIR=storage
PUBLIC_BASE_URL=http://localhost:8000
# Run the SLA watcher inside the API (only for single-instance setups)
ENABLE_SLA_WORKER=true
SLA_WORKER_INTERVAL_SECONDS=30
FCM_SERVER_KEY=
